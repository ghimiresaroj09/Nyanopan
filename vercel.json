{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/inside",
      "destination": "/collections/all-slippers",
      "permanent": true
    },
    {
      "source": "/outside",
      "destination": "/collections/all-slippers",
      "permanent": true
    },
    {
      "source": "/kids",
      "destination": "/collections/all-slippers",
      "permanent": true
    },
    {
      "source": "/babies",
      "destination": "/collections/all-slippers",
      "permanent": true
    }
  ]
}
