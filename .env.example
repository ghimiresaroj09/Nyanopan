# Canonical production URL of the storefront.
# Set this in Vercel under Project Settings > Environment Variables,
# for example after connecting a custom domain.
#
# You can leave it unset for the first deployment: the app then uses the
# Vercel-provided production URL automatically (for sitemap, robots.txt
# and page metadata).
#
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Backend API Configuration
# NEXT_PUBLIC_BACKEND_URL=https://nyanopan.onrender.com
